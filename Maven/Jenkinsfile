pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    tools {
        maven 'maven'
        jdk 'jdk27'
    }
        stage('Compile') {
            steps {
                dir('Maven') {
                    sh 'mvn compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Maven') {
                    sh 'mvn test'
                }
            }
        }

        stage('Build') {
            steps {
                dir('Maven') {
                    sh 'mvn package'
                }
            }
        }
    }
}
