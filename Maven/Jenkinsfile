pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    tools {
        maven 'maven'
        jdk 'jdk27'
    }

    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Avinash9810/Jenkins_manvev11.git'
            }
        }

        stage('Compile') {
            steps {
                dir('apache-maven-3.10.0') {
                    sh 'mvn compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('apache-maven-3.10.0') {
                    sh 'mvn test'
                }
            }
        }

        stage('Build') {
            steps {
                dir('apache-maven-3.10.0') {
                    sh 'mvn package'
                }
            }
        }
    }
}
